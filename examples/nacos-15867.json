 "chains": [
  {
   "id": "shutdown-leak",
   "title": "客户端关闭：注销服务列表变更订阅，避免泄漏与关闭后回调",
   "description": "SecurityProxy 每创建一次就向全局 NotifyCenter 注册一个匿名订阅者，却从不注销，反复创建/关闭 Nacos 客户端会累积订阅者并持有已关闭的对象。此次让 SecurityProxy 保存订阅者并在 shutdown 注销，同时在锁服务与命名运维服务关闭流程里补上漏掉的 securityProxy.shutdown()，并让已关闭的服务列表管理器安全返回空列表。",
   "participants": [
    "NacosLockService / MaintainService",
    "SecurityProxy",
    "NotifyCenter",
    "ServerListManager"
   ],
   "steps": [
    {
     "from": "NacosLockService / MaintainService",
     "to": "ServerListManager",
     "kind": "original",
     "method": "shutdown",
     "description": "先关闭服务列表管理器，停止其 Provider。",
     "file": "H004",
     "line": 154
    },
    {
     "from": "NacosLockService / MaintainService",
     "to": "SecurityProxy",
     "kind": "updated",
     "method": "shutdown",
     "description": "以前这两个服务不关闭 SecurityProxy，其订阅与认证插件一直残留；现在补上调用。",
     "file": "H004",
     "line": 155
    },
    {
     "from": "SecurityProxy",
     "to": "NotifyCenter",
     "kind": "updated",
     "method": "deregisterSubscriber",
     "description": "注销构造时注册的 ServerListChangeEvent 订阅者，之后服务列表变化不再回调该实例。",
     "file": "H003",
     "line": 113
    },
    {
     "from": "SecurityProxy",
     "to": "SecurityProxy",
     "kind": "original",
     "method": "clientAuthPluginManager.shutdown",
     "description": "释放认证插件资源。",
     "file": "H003",
     "line": 114
    },
    {
     "from": "NotifyCenter",
     "to": "ServerListManager",
     "kind": "updated",
     "method": "getServerList",
     "description": "Provider 已关闭时返回空列表而不是抛空指针，保证关闭竞态下的事件回调安全。",
