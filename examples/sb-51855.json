 "chains": [
  {
   "id": "fail-startup",
   "title": "启动时按策略决定是否因待迁移配置而失败",
   "description": "应用升级后若配置里仍有旧键，原来只在启动完成后打印一份报告。此次在 ApplicationPreparedEvent 阶段读取 spring.properties.migrator.fail，生成迁移报告后立即校验，让团队可以在 CI 或预发中把「存在旧键」直接变成启动失败，默认 never 保持原有行为。",
   "participants": [
    "SpringApplication",
    "PropertiesMigrationListener",
    "Binder",
    "Fail 策略"
   ],
   "steps": [
    {
     "from": "SpringApplication",
     "to": "PropertiesMigrationListener",
     "kind": "original",
     "method": "onApplicationEvent",
     "description": "Environment 准备完毕后发布 ApplicationPreparedEvent，监听器收到后进入迁移检查。",
     "file": "F002",
     "line": 60
    },
    {
     "from": "PropertiesMigrationListener",
     "to": "Binder",
     "kind": "updated",
     "method": "bind(spring.properties.migrator.fail)",
     "description": "从 Environment 绑定失败策略；未配置时回落到 NEVER，因此老用户无感知。",
     "file": "F002",
     "line": 71
    },
    {
     "from": "PropertiesMigrationListener",
     "to": "PropertiesMigrationListener",
     "kind": "updated",
     "method": "getReport",
     "description": "先加载 spring-configuration-metadata.json，再生成包含告警（改名键）和错误（不支持键）的报告并保存，用于之后失败时仍能打印。",
     "file": "F002",
     "line": 72
    },
    {
     "from": "PropertiesMigrationListener",
     "to": "Fail 策略",
     "kind": "added",
     "method": "check",
     "description": "NEVER 恒通过；ON_ERROR 在存在错误报告时失败；ON_WARNING 在存在告警或错误时失败。失败抛出 Assert.state 异常。",
     "file": "F001",
